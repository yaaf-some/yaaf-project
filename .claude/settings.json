{
  "permissions": {
    "deny": [
      "Read(~/.aws/**)",
      "Bash(aws *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api * protection*)",
      "Bash(gh api * secrets*)",
      "Bash(gh secret *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": ["~/.aws"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
