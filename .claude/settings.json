{
  "permissions": {
    "deny": ["Read(~/.aws/**)", "Bash(aws *)"]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": ["~/.aws"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
